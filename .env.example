# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan server.

# Port server berjalan (hanya dipakai saat development lokal)
PORT=3000

# Kredensial Supabase (Project Settings > API di dashboard Supabase)
# SUPABASE_KEY memakai publishable/anon key. Kunci ini HANYA dipakai dari server
# (tidak pernah dikirim ke browser), jadi aman disimpan sebagai environment variable.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Token rahasia untuk mengakses panel admin (ganti dengan nilai acak yang sulit ditebak)
ADMIN_TOKEN=ubah-token-ini

# Judul pemilihan yang tampil di halaman
ELECTION_TITLE=Pemilihan Ketua & Wakil Ketua OSIS SMAN 5 BKS
